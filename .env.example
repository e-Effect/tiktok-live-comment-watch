# Tik.toolsを契約したあとに設定
TIKTOOLS_API_KEY=
TIKTOOLS_MODE=direct
TIKTOOLS_MAX_RECONNECT_ATTEMPTS=50

# Render PostgreSQLを作成したあとにInternal Database URLを設定
DATABASE_URL=
LISTENER_ADMIN_KEY=

# LiveCueにも同じイベントを送る場合だけ設定
LIVECUE_ENDPOINT=https://livecue-overlay-jp.kmind007.chatgpt.site/api/events
LIVECUE_CHANNEL_ID=
LIVECUE_ADMIN_TOKEN=

# 再起動後に監視を復元する対象時間
SESSION_RESTORE_MAX_AGE_HOURS=12
